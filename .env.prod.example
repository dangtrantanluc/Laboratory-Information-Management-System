# ===== LIMS production env — docker-compose.prod.yml =====
# Copy to .env.prod, fill in real values, and NEVER commit .env.prod.
# Every value below has no default in docker-compose.prod.yml — compose refuses
# to start if any is missing.

# --- Postgres ---
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# --- MinIO / S3 ---
MINIO_ROOT_USER=CHANGE_ME_not_minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_a_strong_random_password
MINIO_PUBLIC_ENDPOINT=https://files.your-domain.example

# --- JWT (>= 32 random chars, unique per environment) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_48

# --- CORS (comma-separated allowlist of real frontend origins) ---
CORS_ORIGINS=https://lims.your-domain.example

# --- Cloudflare Tunnel — BẮT BUỘC khi dùng docker-compose.cloudflare.yml ---
# Lấy token ở dashboard Cloudflare (DEPLOY_CLOUDFLARE.md §5). Không có biến này
# thì compose từ chối khởi động vì overlay khai ${CLOUDFLARE_TUNNEL_TOKEN:?}.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_token_tu_dashboard_cloudflare

# --- Chỉ đặt khi host CÓ 1 NHÂN: docker-compose.prod.yml khai cpus: 2.0 và
#     Docker từ chối khởi động nếu host ít nhân hơn (DEPLOY_CLOUDFLARE.md §B1) ---
# LIMS_API_CPUS=0.8

# --- Seed admin (rotate immediately after first login) ---
SEED_ADMIN_EMAIL=admin@lims.local
SEED_ADMIN_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# --- Web Push VAPID — generate a dedicated prod keypair, do not reuse dev's ---
# ./scripts/gen-vapid-keys.sh >> .env.prod
# KHÔNG dùng print(v.public_key) của py_vapid: nó in ra đối tượng khoá, không
# phải chuỗi — container vẫn khởi động và Web Push hỏng âm thầm.
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_CLAIMS_EMAIL=admin@your-domain.example

# ═══════════ m30: Tự đăng ký, quên mật khẩu, ảnh đại diện ═══════════
# URL frontend công khai — dùng dựng link trong mail xác thực / đặt lại mật khẩu.
APP_PUBLIC_URL=https://lims.your-domain.example

# SMTP — bắt buộc ở production, nếu bỏ trống thì mail KHÔNG gửi được (chỉ ghi log ERROR).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=CHANGE_ME_app_password_16_ky_tu
SMTP_STARTTLS=true
SMTP_FROM_NAME=Viện CNSH & Môi trường — LIMS

# Giới hạn tên miền được tự đăng ký (bỏ trống = nhận mọi tên miền)
SELF_REGISTRATION_ENABLED=true
SELF_REGISTRATION_ALLOWED_DOMAINS=hcmuaf.edu.vn,st.hcmuaf.edu.vn

# ── R2.2: pool DB khớp số worker uvicorn ──
# tổng kết nối = UVICORN_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + dự phòng
# Đặt UVICORN_WORKERS bằng số nhân CPU của host (kiểm bằng: nproc).
UVICORN_WORKERS=4
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT=5

# ── R3.2: thu hẹp cửa sổ rủi ro khi token bị lộ ──
# Access token là JWT stateless: thu hồi chỉ có hiệu lực qua jti denylist trong
# Redis. TTL ngắn hơn = thời gian token lậu còn dùng được ngắn hơn.
ACCESS_TOKEN_TTL_MINUTES=10
