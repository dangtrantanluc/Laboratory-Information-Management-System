# ===== LIMS Backend (M7) — biến môi trường =====
# Copy file này thành .env và chỉnh giá trị thật. KHÔNG commit .env.

# --- App ---
APP_NAME=LIMS Backend (M7 Platform)
ENVIRONMENT=development            # development | staging | production
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database (trong docker-compose, host = 'postgres') ---
DATABASE_URL=postgresql+psycopg2://lims:lims@postgres:5432/lims
DB_ECHO=false

# --- Redis (host = 'redis' trong docker-compose) ---
REDIS_URL=redis://redis:6379/0

# --- JWT (BẮT BUỘC đổi secret production, >= 32 ký tự) ---
JWT_SECRET=CHANGE_ME_super_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30        # <= 60 (NFR-SEC-003)
REFRESH_TOKEN_TTL_DAYS=30          # <= 30

# --- Auth lockout ---
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_MINUTES=15

# --- Scheduler (APScheduler) — chỉ 1 replica/worker nên bật khi scale ngang ---
SCHEDULER_ENABLED=true

# --- MinIO / S3 (host = 'minio' trong docker-compose) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000   # endpoint FE truy cập presigned URL
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lims-attachments
MINIO_SECURE=false
PRESIGNED_URL_TTL_SECONDS=900

# --- File upload ---
MAX_UPLOAD_SIZE_BYTES=20971520     # 20MB

# --- CORS (origin frontend, phân tách dấu phẩy) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3050

# --- Seed admin (CHỈ khởi tạo — ép đổi mật khẩu lần đầu) ---
SEED_ADMIN_EMAIL=admin@lims.local
SEED_ADMIN_PASSWORD=ChangeMe@123

# --- Web Push VAPID (M20 — popup thông báo desktop) ---
# KHÔNG bao giờ đặt khoá thật vào file này — nó được commit lên repo.
# Sinh cặp khoá rồi đặt vào .env (đã gitignore):
#   python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=thay-bang-khoa-cong-khai-cua-ban
VAPID_PRIVATE_KEY=thay-bang-khoa-rieng-cua-ban
VAPID_CLAIMS_EMAIL=admin@lims.local

# ═══════════ m30: Tự đăng ký, quên mật khẩu, ảnh đại diện ═══════════

# URL công khai của FRONTEND — dùng dựng link trong mail. Sai giá trị này thì link
# trong thư trỏ nhầm chỗ. Production phải là domain thật (https://lims.your-domain).
APP_PUBLIC_URL=http://localhost:3060

# --- SMTP ---
# Bỏ trống SMTP_HOST ⇒ chế độ DEV: không gửi thật, ghi nội dung mail (kèm link) ra log.
#
# Gmail cá nhân:
#   1. Bật xác minh 2 bước cho tài khoản Google
#   2. Vào https://myaccount.google.com/apppasswords → tạo "App password"
#   3. Dán mật khẩu ứng dụng 16 ký tự (KHÔNG phải mật khẩu Gmail) vào SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false                       # true nếu dùng cổng 465 thay vì 587
SMTP_FROM=                           # bỏ trống → dùng SMTP_USER
SMTP_FROM_NAME=Viện CNSH & Môi trường — LIMS
SMTP_TIMEOUT_SECONDS=10

# --- Hiệu lực token trong mail ---
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- Đăng ký tự phục vụ ---
# Tài khoản đăng ký LUÔN ở trạng thái 'pending' và phải được Quản trị viên duyệt;
# cờ dưới chỉ quyết định có mở form đăng ký công khai hay không.
SELF_REGISTRATION_ENABLED=true
# Bỏ trống = nhận mọi tên miền. Điền để giới hạn, vd: hcmuaf.edu.vn,st.hcmuaf.edu.vn
SELF_REGISTRATION_ALLOWED_DOMAINS=

# --- Ảnh đại diện ---
AVATAR_MAX_SIZE_BYTES=2097152        # 2MB

# ── R2.2: pool DB khớp số worker uvicorn ──
# tổng kết nối = UVICORN_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + dự phòng
# Đặt UVICORN_WORKERS bằng số nhân CPU của host (kiểm bằng: nproc).
UVICORN_WORKERS=4
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT=5
